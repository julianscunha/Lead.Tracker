# Real install config — never versioned
.env

# Tech.Forge Core clone for local module testing (not part of Lead.Tracker)
.techforge-dev/

# Python
__pycache__/
*.pyc
.pytest_cache/

# Instalação local de módulo feita por engano na raiz do repo (o clone de
# teste de verdade vive isolado em .techforge-dev/, já ignorado acima)
/modules/

# Frontend — build output e deps, não código-fonte (rodar `npm run build` em frontend/)
frontend/node_modules/
frontend/index.js

# Banco de dados local — dado real da instalação, nunca versionado
data/*.db
data/*.db-journal

# Artefato de release (.mod) — anexado ao GitHub Release, não versionado
dist/

# Claude Code — config/skills/agents locais, não fazem parte do módulo
.claude/
skills-lock.json

# Artefatos de sessão de browser-testing (Playwright MCP) — nunca fazem parte do módulo
.playwright-mcp/
