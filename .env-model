APP_ENV=local
LOG_LEVEL=INFO

# Valores válidos: openrouter (padrão) | openai | gemini | claude
AI_PROVIDER=openrouter
AI_API_KEY=

WEBSITE_ENABLED=false
COMPANY_WEBSITE=

SALESFORCE_ENABLED=false
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
SALESFORCE_LOGIN_URL=

# Enriquecimento de porte e setor por uma API HTTP JSON de sua escolha (sob demanda, nunca no sync).
# URL com {domain}, ex.: https://api.exemplo.com/v1/companies?domain={domain}
ENRICHMENT_ENABLED=false
ENRICHMENT_URL_TEMPLATE=
ENRICHMENT_AUTH_HEADER=
ENRICHMENT_API_KEY=
# Caminhos com pontos dentro do JSON, ex.: metrics.employees
ENRICHMENT_MAP_EMPLOYEES=
ENRICHMENT_MAP_INDUSTRY=

GOOGLE_MAPS_ENABLED=false
GOOGLE_MAPS_API_KEY=

# Dias em "detectada" sem virar qualificada/descartada antes de alertar
# triagem atrasada (Fase D do roadmap).
AGING_SLA_DAYS=7

# Mínimo de oportunidades por representante e categoria pra mostrar o
# alcance do funil; abaixo disso a tela mostra "dado insuficiente".
REP_CATEGORY_MIN_SAMPLE=5

# Trava anti-spam de prospecção geográfica (Fase E, módulo 5): score
# mínimo (0.0-1.0) pra uma descoberta virar Company/Opportunity real, e
# cap diário de promoções por representante.
GEO_PROMOTION_MIN_SCORE=0.75
GEO_PROMOTION_DAILY_CAP=20
